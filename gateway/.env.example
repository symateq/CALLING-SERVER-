# Copy to .env for local development. Never commit the real .env.
# All values below are placeholders — none of this is a real credential.

# SQLite file for local/dev. On the calling server this stays a local file too;
# it is deliberately NOT the Company OS Postgres database.
DATABASE_URL="file:./dev.db"

# Entra ID (Microsoft identity platform) — same tenant as Company OS SSO, reused,
# not duplicated. Gateway validates tokens against this tenant only.
AZURE_AD_TENANT_ID="00000000-0000-0000-0000-000000000000"
# Application (client) ID of the native app registration(s) this gateway accepts
# tokens for. Comma-separated if Android/Windows get separate app registrations.
AZURE_AD_AUDIENCE="00000000-0000-0000-0000-000000000000"

# Stopgap admin bearer token for the /admin endpoints (approve a user for calling,
# assign a line) until a real admin UI exists. Generate a long random value;
# never reuse it anywhere else. Required in production; the server refuses to
# start without it unless NODE_ENV=test.
GATEWAY_ADMIN_TOKEN="replace-with-a-long-random-value"

PORT=8081
NODE_ENV=development
