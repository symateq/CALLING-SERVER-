[global]
type=global

[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0:8088
external_media_address=127.0.0.1
external_signaling_address=127.0.0.1

[webrtc-test]
type=aor
max_contacts=1

[webrtc-test-auth]
type=auth
auth_type=userpass
username=webrtc-test
password=local-test-only-not-a-real-secret

[webrtc-test]
type=endpoint
context=webrtc-test
disallow=all
allow=opus
allow=ulaw
webrtc=yes
aors=webrtc-test
auth=webrtc-test-auth
